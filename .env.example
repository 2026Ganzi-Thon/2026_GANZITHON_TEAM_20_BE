SPRING_PROFILES_ACTIVE=local
POSTGRES_PORT=5432
POSTGRES_DB=nightvault
POSTGRES_USER=nightvault
POSTGRES_PASSWORD=nightvault-local-dev
# Generate a 32-byte Base64 NIGHTVAULT_DATA_KEY in the local .env for analysis.
# Uncomment to route the local Spring worker to the Python mock API.
# NIGHTVAULT_AI_URL=http://127.0.0.1:8001/internal/v1/analyze
# Optional: set the same NIGHTVAULT_AI_TOKEN in Spring and the Python process.
# The Python process defaults to mock mode.
# NIGHTVAULT_AI_MODE=solar
# UPSTAGE_API_KEY=
# UPSTAGE_MODEL=solar-mini4
# UPSTAGE_TIMEOUT_SECONDS=10
# NIGHTVAULT_AI_TIMEOUT_SECONDS=12
# Web Push uses a browser-compatible VAPID key pair and contact subject.
# NIGHTVAULT_PUSH_PUBLIC_KEY=
# NIGHTVAULT_PUSH_PRIVATE_KEY=
# NIGHTVAULT_PUSH_SUBJECT=mailto:admin@example.com
